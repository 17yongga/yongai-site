---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    number: '01',
    title: 'Choose the right workflow',
    body: 'We look at the work as it is today—people, handoffs, systems, exceptions, and risk—then identify where AI can create a useful operating advantage.',
  },
  {
    number: '02',
    title: 'Design the operating system',
    body: 'We define what the system can do, what data it can touch, where human approval stays, and how the team will judge whether it is working.',
  },
  {
    number: '03',
    title: 'Build and integrate it',
    body: 'We prototype the smallest useful version, connect it to the real workflow, test edge cases, and refine it with the people who will use it.',
  },
  {
    number: '04',
    title: 'Make it stick',
    body: 'We document the system, train the team, hand over clear ownership, and stay involved when ongoing support is the right model.',
  },
];

const engagements = [
  {
    name: 'Leadership alignment',
    label: 'Start with the decision',
    body: 'A focused working session for leaders who need a shared view of AI, vendor claims, risk, and where to begin.',
    outcome: 'A clear point of view and the next decision to make.',
  },
  {
    name: 'Workflow audit',
    label: 'Start with the work',
    body: 'A practical review of one operation, including the current process, friction, data boundaries, controls, and candidate use cases.',
    outcome: 'A prioritized opportunity map and a build recommendation.',
  },
  {
    name: 'Pilot build',
    label: 'Start with proof',
    body: 'A bounded implementation around one useful workflow—not a platform rewrite and not a demo that disappears after presentation day.',
    outcome: 'A working pilot, adoption plan, and evidence for the next investment.',
  },
  {
    name: 'Embedded partner',
    label: 'Continue with ownership',
    body: 'Ongoing advisory, delivery, enablement, and improvement for teams that need a steady AI implementation partner.',
    outcome: 'A managed roadmap with visible ownership and regular releases.',
  },
];

const examples = [
  ['Service operations', 'Prepare case context, route requests, draft responses, and keep approval with the accountable team.'],
  ['Reconciliation and exceptions', 'Bring mismatches together, explain likely causes, and prepare the next investigation step.'],
  ['Management reporting', 'Gather recurring inputs, flag missing evidence, and prepare a review-ready operating brief.'],
  ['Knowledge-heavy work', 'Find the relevant policy, precedent, or project context without making people search across five systems.'],
];
---

<Layout
  title="YongAI Systems — Applied AI for operating teams"
  description="YongAI Systems helps businesses find, build, and adopt practical AI systems around real workflows—with clear controls, human ownership, and implementation discipline."
  ogImage="https://yongai.ca/brand/v3/YongAI_website_header_black_on_light_2400x600.png"
  robots="noindex,nofollow"
>
  <main class="systems-page">
    <nav class="systems-nav" aria-label="YongAI Systems navigation">
      <a class="systems-brand" href="/" aria-label="YongAI home">
        <img src="/brand/v3/YongAI_horizontal_black_transparent.svg" alt="YongAI" />
        <span>Systems</span>
      </a>
      <div class="desktop-links">
        <a href="#work">What we do</a>
        <a href="#engagements">Ways to start</a>
        <a href="#fit">Where it fits</a>
      </div>
      <a class="nav-cta" href="https://calendly.com/gary-yong-yongai/30min">Discuss a workflow</a>
    </nav>

    <section class="hero shell">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">YongAI Systems · Applied AI for operating teams</p>
        <h1>Turn one stuck workflow into a working AI system.</h1>
        <p class="hero-lead">
          Most businesses do not need another AI transformation speech. They need a clear answer to where AI belongs, what it should touch, and who stays accountable. We map the work, build one useful system, and stay through adoption.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="https://calendly.com/gary-yong-yongai/30min">Bring us a workflow</a>
          <a class="button secondary" href="#work">See how we work</a>
        </div>
        <p class="hero-note">Toronto · Strategy, implementation, enablement, and ongoing support</p>
      </div>

      <aside class="operating-map" aria-label="Example AI-assisted workflow with a human approval gate" data-reveal style="--reveal-delay: 100ms">
        <div class="map-heading">
          <span>Operating map / 01</span>
          <strong>A useful system has boundaries.</strong>
        </div>
        <div class="map-flow">
          <div class="map-source">
            <span>Signal</span>
            <strong>Customer request</strong>
            <small>Inbox · CRM · ticket queue</small>
          </div>
          <div class="map-arrow" aria-hidden="true">→</div>
          <div class="map-source dark">
            <span>Context</span>
            <strong>AI prepares the work</strong>
            <small>Retrieve · compare · draft</small>
          </div>
          <div class="map-arrow" aria-hidden="true">→</div>
          <div class="map-source gate">
            <span>Control</span>
            <strong>Human reviews</strong>
            <small>Approve · change · decline</small>
          </div>
        </div>
        <div class="map-output">
          <span>Prepared outcome</span>
          <strong>The next step is ready. The accountable person still makes the call.</strong>
        </div>
      </aside>
    </section>

    <section class="pressure-section shell" data-reveal>
      <div class="section-intro">
        <p class="eyebrow">The operating gap</p>
        <h2>AI pressure arrives before a practical plan.</h2>
      </div>
      <div class="pressure-story" aria-label="How AI initiatives stall">
        <article><span>01</span><h3>The question arrives</h3><p>Leadership wants an AI plan. Teams are already trying tools. Vendors are making broad promises.</p></article>
        <div class="story-line" aria-hidden="true"></div>
        <article><span>02</span><h3>The work stays unclear</h3><p>No one has mapped the real handoffs, data, exceptions, controls, or ownership behind the process.</p></article>
        <div class="story-line" aria-hidden="true"></div>
        <article><span>03</span><h3>The pilot stalls</h3><p>A demo gets built, but it sits outside the operating rhythm and never becomes dependable work.</p></article>
      </div>
      <p class="pressure-close">YongAI Systems starts with the operation—not the model.</p>
    </section>

    <section id="work" class="services-section shell">
      <div class="section-intro wide" data-reveal>
        <div><p class="eyebrow">What we do</p><h2>Strategy that stays for implementation.</h2></div>
        <p>Strategy does not stop at a roadmap. We move from workflow selection to a controlled build, then stay long enough for the team to use it with confidence. The goal is not more AI activity. It is one system the business can understand, use, and own.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article data-reveal style={`--reveal-delay: ${(index % 2) * 70}ms`}>
            <span>{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="engagements" class="engagement-section">
      <div class="shell">
        <div class="section-intro light" data-reveal>
          <p class="eyebrow">Ways to start</p>
          <h2>Meet the business where it is.</h2>
          <p>No forced transformation program. Start with the decision, the workflow, the proof, or the need for ongoing ownership.</p>
        </div>
        <div class="engagement-list">
          {engagements.map((engagement, index) => (
            <article data-reveal style={`--reveal-delay: ${index * 55}ms`}>
              <div class="engagement-index">0{index + 1}</div>
              <div class="engagement-name"><span>{engagement.label}</span><h3>{engagement.name}</h3></div>
              <p>{engagement.body}</p>
              <div class="engagement-outcome"><span>Leaves you with</span><strong>{engagement.outcome}</strong></div>
            </article>
          ))}
        </div>
        <p class="scope-note">Scope and commercial terms are defined after a fit call, once the workflow and delivery boundary are clear.</p>
      </div>
    </section>

    <section class="examples-section shell">
      <div class="section-intro" data-reveal>
        <p class="eyebrow">Recognizable first wins</p>
        <h2>Start where context is expensive and handoffs keep breaking.</h2>
      </div>
      <div class="example-list">
        {examples.map(([title, body], index) => (
          <article data-reveal style={`--reveal-delay: ${(index % 2) * 60}ms`}>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="fit" class="fit-section shell" data-reveal>
      <div class="section-intro">
        <p class="eyebrow">Where it fits</p>
        <h2>Two audiences. Two delivery models.</h2>
        <p>UrHermes and Systems share the same practical philosophy, but they are designed for different operating realities.</p>
      </div>
      <div class="fit-grid">
        <article>
          <div class="fit-label"><span>Individuals / solo founders</span><strong>UrHermes</strong></div>
          <h3>Your private AI operator.</h3>
          <p>Personal setup around your own tools, memory, recurring work, approval rules, and handoff. Designed for one person or a very small founder-led operation.</p>
          <a href="https://urhermes.com/">Visit UrHermes →</a>
        </article>
        <article class="active">
          <div class="fit-label"><span>Teams / established businesses</span><strong>YongAI Systems</strong></div>
          <h3>Applied AI for shared operations.</h3>
          <p>Leadership alignment, workflow mapping, governance, implementation, team adoption, and ongoing ownership across a business process.</p>
          <a href="#engagements">Choose a starting point →</a>
        </article>
      </div>
      <p class="parent-note"><strong>YongAI</strong> remains the parent portfolio: focused products, service ventures, and applied AI systems built with operator discipline.</p>
    </section>

    <section class="operator-section shell" data-reveal>
      <div class="operator-card">
        <div class="operator-heading"><p class="eyebrow">Why this operator</p><h2>Implementation experience, not AI theatre.</h2></div>
        <div class="operator-copy">
          <p>Gary Yong is a Toronto-based implementation consultant and product operator. His background spans platform migration, cutover, operational reconciliation, and wealth operations transformation. Through YongAI, he also builds and tests software products directly.</p>
          <p>YongAI Systems brings those two sides together: understand the operation, design around the control points, ship a working surface, and stay accountable through adoption.</p>
          <div class="operator-proof">
            <span>Enterprise implementation</span>
            <span>Operational transformation</span>
            <span>Product building</span>
            <span>Toronto-based</span>
          </div>
        </div>
      </div>
    </section>

    <section class="final-cta shell" data-reveal>
      <div>
        <p class="eyebrow">Start with one real workflow</p>
        <h2>What keeps slipping between people, systems, and follow-up?</h2>
        <p>Bring the current process—not a polished AI brief. We can decide together whether the right next step is alignment, an audit, a pilot, or no build at all.</p>
      </div>
      <div class="final-actions">
        <a class="button inverse" href="https://calendly.com/gary-yong-yongai/30min">Book a fit call</a>
        <a class="text-link" href="mailto:gary.yong@yongai.ca">gary.yong@yongai.ca →</a>
      </div>
    </section>

    <footer class="systems-footer shell">
      <a href="/" aria-label="YongAI home">YongAI</a>
      <p>A YongAI venture for applied AI services.</p>
      <div><a href="https://urhermes.com/">UrHermes</a><a href="mailto:gary.yong@yongai.ca">Contact</a><a href="https://www.linkedin.com/in/gary-yong-66a9ba164">LinkedIn</a></div>
    </footer>
  </main>
</Layout>

<style>
  :global(body) { margin: 0; background: #F5F1E8; }
  :global(*) { box-sizing: border-box; }
  .systems-page { --ink:#11120F; --paper:#F5F1E8; --white:#FFF; --muted:#625F56; --line:rgba(17,18,15,.14); min-height:100vh; overflow-x:hidden; color:var(--ink); background:radial-gradient(circle at 82% 11%,rgba(200,190,169,.26),transparent 31rem),linear-gradient(180deg,#FCFBF7 0%,var(--paper) 48%,#ECE6DA 100%); font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; }
  .shell { width:min(1180px,calc(100% - 48px)); margin-inline:auto; }
  h1,h2,h3,p { margin-top:0; }
  h1,h2,h3 { font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif; }
  .eyebrow { margin:0 0 15px; color:var(--muted); font-size:11px; font-weight:850; letter-spacing:.18em; text-transform:uppercase; }

  .systems-nav { width:min(1180px,calc(100% - 48px)); min-height:80px; margin-inline:auto; display:flex; align-items:center; justify-content:space-between; gap:26px; border-bottom:1px solid var(--line); }
  .systems-brand { display:flex; align-items:center; gap:14px; color:var(--ink); text-decoration:none; }
  .systems-brand img { width:158px; height:auto; min-height:0!important; display:block; }
  .systems-brand span { padding-left:14px; border-left:1px solid var(--line); font-family:'Cormorant Garamond',Georgia,serif; font-size:22px; font-weight:700; }
  .desktop-links { display:flex; align-items:center; gap:25px; margin-left:auto; }
  .desktop-links a { min-height:44px; display:inline-flex; align-items:center; color:#45443F; font-size:13px; font-weight:720; text-decoration:none; }
  .desktop-links a:hover,.desktop-links a:focus-visible { color:#000; }
  .nav-cta { min-height:44px; padding:0 17px; display:inline-flex; align-items:center; border:1px solid var(--ink); color:#fff; background:var(--ink); font-size:13px; font-weight:800; text-decoration:none; transition:transform var(--motion-base) var(--motion-ease),box-shadow var(--motion-base) var(--motion-ease); }
  .nav-cta:hover,.nav-cta:focus-visible { transform:translateY(-2px); box-shadow:0 12px 28px rgba(0,0,0,.14); }

  .hero { min-height:calc(88vh - 80px); padding-block:64px 76px; display:grid; grid-template-columns:minmax(0,1fr) minmax(390px,.78fr); gap:clamp(46px,7vw,94px); align-items:center; }
  .hero h1 { max-width:770px; margin-bottom:24px; font-size:clamp(58px,6.8vw,92px); line-height:.95; letter-spacing:-.03em; }
  .hero-lead { max-width:700px; margin-bottom:30px; color:#34342F; font-size:clamp(18px,1.7vw,21px); line-height:1.65; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:11px; }
  .button { min-height:50px; padding:0 21px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--ink); color:var(--ink); font-size:14px; font-weight:820; text-decoration:none; transition:transform var(--motion-base) var(--motion-ease),box-shadow var(--motion-base) var(--motion-ease),background var(--motion-fast) ease,color var(--motion-fast) ease; }
  .button.primary { color:#fff; background:var(--ink); box-shadow:0 17px 36px rgba(0,0,0,.14); }
  .button.secondary { background:rgba(255,255,255,.56); }
  .button:hover,.button:focus-visible { transform:translateY(-2px); }
  .button:active { transform:translateY(0) scale(.988); }
  .hero-note { margin:18px 0 0; color:#77736A; font-size:12px; font-weight:700; letter-spacing:.04em; }

  .operating-map { padding:24px; border:1px solid rgba(17,18,15,.18); background:rgba(255,255,255,.74); box-shadow:0 28px 80px rgba(42,38,29,.10); }
  .map-heading { display:flex; justify-content:space-between; gap:20px; padding-bottom:21px; border-bottom:1px solid var(--line); }
  .map-heading span,.map-source span,.map-output span,.engagement-outcome span { color:#77736A; font-size:10px; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .map-heading strong { max-width:190px; font-family:'Cormorant Garamond',Georgia,serif; font-size:22px; line-height:1.05; text-align:right; }
  .map-flow { display:grid; grid-template-columns:1fr 24px 1fr 24px 1fr; align-items:stretch; padding-block:24px; }
  .map-source { min-width:0; padding:15px 13px; border:1px solid var(--line); background:#F9F6EF; }
  .map-source.dark { color:#fff; background:var(--ink); }
  .map-source.gate { border-style:dashed; background:#fff; }
  .map-source span { display:block; margin-bottom:18px; }
  .map-source.dark span { color:rgba(255,255,255,.48); }
  .map-source strong { display:block; margin-bottom:8px; font-size:13px; line-height:1.35; }
  .map-source small { display:block; color:#77736A; font-size:10px; line-height:1.4; }
  .map-source.dark small { color:rgba(255,255,255,.5); }
  .map-arrow { display:grid; place-items:center; color:#8D887D; }
  .map-output { padding:17px; border-left:3px solid var(--ink); background:#EAE4D8; }
  .map-output span { display:block; margin-bottom:7px; }
  .map-output strong { display:block; font-size:14px; line-height:1.48; }

  .section-intro { max-width:790px; }
  .section-intro h2 { margin-bottom:18px; font-size:clamp(40px,5vw,62px); line-height:1.01; letter-spacing:-.018em; }
  .section-intro > p:last-child,.section-intro.wide > p { color:#45443F; font-size:17px; line-height:1.65; }
  .pressure-section { padding-block:82px; border-top:1px solid var(--line); }
  .pressure-story { margin-top:38px; display:grid; grid-template-columns:1fr 52px 1fr 52px 1fr; align-items:center; }
  .pressure-story article { min-height:250px; padding:25px; border:1px solid var(--line); background:rgba(255,255,255,.58); }
  .pressure-story article span,.service-grid article>span,.example-list article>span { display:block; margin-bottom:48px; color:#77736A; font-size:11px; font-weight:850; letter-spacing:.16em; }
  .pressure-story h3,.service-grid h3,.example-list h3 { margin-bottom:13px; font-size:28px; line-height:1.08; }
  .pressure-story p,.service-grid p,.example-list p { margin:0; color:#4A4842; font-size:15px; line-height:1.6; }
  .story-line { height:1px; background:var(--line); }
  .pressure-close { margin:25px 0 0; font-family:'Cormorant Garamond',Georgia,serif; font-size:25px; font-weight:700; text-align:center; }

  .services-section { padding-block:84px; }
  .section-intro.wide { max-width:none; display:grid; grid-template-columns:1fr .82fr; gap:clamp(36px,8vw,110px); align-items:end; }
  .service-grid { margin-top:34px; display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
  .service-grid article { min-height:300px; padding:27px; border:1px solid var(--line); background:rgba(255,255,255,.62); transition:transform var(--motion-base) var(--motion-ease),box-shadow var(--motion-base) var(--motion-ease),background var(--motion-fast) ease; }
  .service-grid article:hover { transform:translateY(-3px); background:#fff; box-shadow:0 20px 50px rgba(42,38,29,.08); }
  .service-grid h3 { max-width:430px; font-size:35px; }
  .service-grid p { max-width:600px; font-size:16px; }

  .engagement-section { padding-block:90px; color:#fff; background:var(--ink); }
  .section-intro.light { max-width:760px; }
  .section-intro.light .eyebrow { color:rgba(255,255,255,.46); }
  .section-intro.light h2 { color:#fff; }
  .section-intro.light>p:last-child { color:rgba(255,255,255,.62); }
  .engagement-list { margin-top:38px; border-top:1px solid rgba(255,255,255,.18); }
  .engagement-list article { display:grid; grid-template-columns:64px 1.05fr 1.25fr 1fr; gap:26px; align-items:start; padding:28px 0; border-bottom:1px solid rgba(255,255,255,.18); }
  .engagement-index { color:rgba(255,255,255,.35); font-size:12px; font-weight:850; letter-spacing:.13em; }
  .engagement-name span { display:block; margin-bottom:8px; color:rgba(255,255,255,.44); font-size:10px; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .engagement-name h3 { margin:0; color:#fff; font-size:29px; line-height:1.05; }
  .engagement-list article>p { margin:0; color:rgba(255,255,255,.66); font-size:14px; line-height:1.6; }
  .engagement-outcome { padding-left:20px; border-left:1px solid rgba(255,255,255,.18); }
  .engagement-outcome span { display:block; margin-bottom:8px; color:rgba(255,255,255,.38); }
  .engagement-outcome strong { display:block; color:rgba(255,255,255,.9); font-size:13px; line-height:1.5; }
  .scope-note { max-width:740px; margin:25px 0 0; color:rgba(255,255,255,.46); font-size:12px; line-height:1.55; }

  .examples-section { padding-block:90px; }
  .example-list { margin-top:34px; display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--line); border:1px solid var(--line); }
  .example-list article { min-height:245px; padding:27px; background:#F8F5EE; }
  .example-list article>span { margin-bottom:35px; }

  .fit-section { padding-block:82px; border-top:1px solid var(--line); }
  .fit-grid { margin-top:36px; display:grid; grid-template-columns:repeat(2,1fr); gap:15px; }
  .fit-grid article { min-height:360px; padding:28px; display:flex; flex-direction:column; border:1px solid var(--line); background:rgba(255,255,255,.62); }
  .fit-grid article.active { color:#fff; background:var(--ink); }
  .fit-label { display:flex; justify-content:space-between; gap:18px; margin-bottom:64px; }
  .fit-label span { color:#77736A; font-size:10px; font-weight:850; letter-spacing:.13em; text-transform:uppercase; }
  .active .fit-label span { color:rgba(255,255,255,.46); }
  .fit-label strong { font-family:'Cormorant Garamond',Georgia,serif; font-size:18px; }
  .fit-grid h3 { margin-bottom:16px; font-size:36px; line-height:1.02; }
  .fit-grid p { margin:0 0 24px; color:#45443F; font-size:16px; line-height:1.62; }
  .fit-grid .active p { color:rgba(255,255,255,.65); }
  .fit-grid a { min-height:44px; margin-top:auto; display:inline-flex; align-items:center; color:inherit; font-size:13px; font-weight:820; text-underline-offset:5px; }
  .parent-note { margin:24px 0 0; color:#625F56; font-size:14px; line-height:1.55; }

  .operator-section { padding-block:70px 92px; }
  .operator-card { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(40px,8vw,110px); padding:42px; border:1px solid var(--line); background:#EAE4D8; }
  .operator-heading h2 { margin:0; font-size:clamp(40px,5vw,61px); line-height:1.01; }
  .operator-copy p { color:#3F3D38; font-size:16px; line-height:1.68; }
  .operator-proof { display:flex; flex-wrap:wrap; gap:7px; margin-top:23px; }
  .operator-proof span { padding:8px 10px; border:1px solid rgba(17,18,15,.14); background:rgba(255,255,255,.42); font-size:11px; font-weight:760; }

  .final-cta { margin-bottom:74px; padding:42px; display:grid; grid-template-columns:1fr auto; gap:60px; align-items:end; color:#fff; background:var(--ink); }
  .final-cta .eyebrow { color:rgba(255,255,255,.44); }
  .final-cta h2 { max-width:780px; margin-bottom:17px; color:#fff; font-size:clamp(42px,5vw,64px); line-height:1; }
  .final-cta p:last-child { max-width:720px; margin:0; color:rgba(255,255,255,.62); font-size:16px; line-height:1.62; }
  .final-actions { display:grid; gap:14px; min-width:190px; }
  .button.inverse { color:var(--ink); background:#fff; border-color:#fff; }
  .text-link { min-height:44px; display:inline-flex; align-items:center; color:#fff; font-size:13px; font-weight:780; text-underline-offset:5px; }

